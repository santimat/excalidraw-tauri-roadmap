---
import Step from "@components/home/Step.astro";
import type { StepProps } from "@components/home/Step.astro";

export interface PhaseProps {
  phase?: number;
  title: string;
  steps: StepProps[];
}

const { phase, title, steps } = Astro.props as PhaseProps;

const phaseNumber = phase?.toString().padStart(2, "0");
---

<article>
  <div class="flex items-center gap-4 mb-6">
    <span class="code-font bg-stone-900 text-white px-3 py-1 text-sm rounded"
      >{phaseNumber}</span
    >
    <h3 class="text-3xl font-extrabold text-stone-800">
      {title}
    </h3>
  </div>

  <div class="grid gap-6">
    {steps?.map((step, i) => <Step {...step} step={i + 1} phase={phase} />)}
  </div>
</article>
