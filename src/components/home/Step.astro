---
import Source from "@components/home/Source.astro";

export interface Source {
  name: string;
  url: string;
}
export interface StepProps {
  phase?: number;
  step?: number;
  title: string;
  description: string;
  sources: Source[];
}

const { phase, title, description, step, sources } =
  Astro.props as Partial<StepProps>;
const stepNumber = `${phase}.${step}`;
---

<article
  class="border-l-2 border-border-step transition-all p-6 rounded-r-xl hover:border-accent-sage hover:bg-white shadow-lg"
>
  <h4 class="font-bold text-stone-800 mb-2 text-lg">
    <span>{stepNumber}</span>
    {title}
  </h4>
  <p class="text-stone-600 text-sm leading-relaxed text-sage-700">
    {description}
  </p>
  <ul class="flex mt-4 text-white">
    {sources?.map((source) => <Source {...source} />)}
  </ul>
</article>
