---
interface Props {
  title: string;
}
const { title }: Props = Astro.props;
import "@styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="shortcut icon" href="favicon.png" type="image/png" />
    <meta
      name="description"
      content="Roadmap to improve Frontend skills, learn some backend skills with rust and build native apps with tauri"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
